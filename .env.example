# Número de WhatsApp en formato internacional, solo dígitos. Opcional: por defecto 573219518808.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Cómo se muestra el número en pantalla. Opcional: por defecto "321 951 8808".
NEXT_PUBLIC_WHATSAPP_DISPLAY=

# Public site URL, used for SEO metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://crazyshine.example

# Optional business details shown in the footer.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_INSTAGRAM_HANDLE=
NEXT_PUBLIC_LOCATION=
NEXT_PUBLIC_MAPS_URL=
NEXT_PUBLIC_HOURS=

# Neon (PostgreSQL) connection string — stores booking requests.
# Create a project at neon.tech, copy the pooled connection string, then run: npm run db:setup
# Without it, the booking form still works and simply hands off to WhatsApp.
DATABASE_URL=
