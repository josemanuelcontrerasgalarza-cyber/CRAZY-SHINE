# WhatsApp number in international format, digits only (e.g. country code + number).
# Leave empty and the booking buttons open WhatsApp's contact picker with the message prefilled.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public site URL, used for SEO metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://crazyshine.example

# Optional business details shown in the footer.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_INSTAGRAM_HANDLE=
NEXT_PUBLIC_LOCATION=
NEXT_PUBLIC_MAPS_URL=
NEXT_PUBLIC_HOURS=
